---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogUrl?: string;
  ogImage?: string;
  ogSiteName?: string;
  twitterEmbeds?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props} stylesheet="blog-layout">
  <slot />
</BaseLayout>
