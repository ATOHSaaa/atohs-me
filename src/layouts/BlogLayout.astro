---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogUrl?: string;
  ogImage?: string;
  ogSiteName?: string;
}

const props = Astro.props;
---

<BaseLayout {...props} includeSiteStyles={false}>
  <slot />
</BaseLayout>

<style is:global>
  @import '../styles/blog-layout.css';
</style>
