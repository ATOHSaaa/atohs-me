---
import ClientRouter from 'astro/components/ClientRouter.astro';
import { getImage } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import { GOOGLE_FONTS_STYLESHEET_HREF } from '../lib/google-fonts';
import { SITE_FAVICON_SRC, siteLogo, SITE_LOGO_DISPLAY_SIZE } from '../lib/site-logo';

const siteLogoPreload = await getImage({
  src: siteLogo,
  format: 'webp',
  width: SITE_LOGO_DISPLAY_SIZE,
  height: SITE_LOGO_DISPLAY_SIZE,
});

interface Props {
  title: string;
  description?: string;
  ogUrl?: string;
  ogImage?: string;
  ogSiteName?: string;
}

const {
  title,
  description = 'atohs(あとーす)のポートフォリオサイトです。メディア運営、執筆・編集、文字起こし、写真撮影、校正などを行っています。',
  ogUrl = 'https://atohs.me',
  ogImage = 'https://atohs.me/src/ogp.png',
  ogSiteName = 'atohs.me',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@atohsaaa" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={SITE_FAVICON_SRC} />
    <link
      rel="preload"
      href={siteLogoPreload.src}
      as="image"
      type="image/webp"
      fetchpriority="high"
    />
    <ClientRouter fallback="none" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={GOOGLE_FONTS_STYLESHEET_HREF} rel="stylesheet" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3S8S7JGPEZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-3S8S7JGPEZ');
    </script>
  </head>
  <body class="site">
    <a class="skip-link" href="#main-content">メインコンテンツへスキップ</a>
    <div class="site-content">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>

<style is:global>
  @import '../styles/core.css';
</style>
