---
import { getImage } from 'astro:assets';
import { SITE_FAVICON_SRC, siteLogo, SITE_LOGO_DISPLAY_SIZE } from '../lib/site-logo';
const siteLogoPreload = await getImage({
  src: siteLogo,
  format: 'webp',
  width: SITE_LOGO_DISPLAY_SIZE,
  height: SITE_LOGO_DISPLAY_SIZE,
});

interface Props {
  title: string;
  description?: string;
  ogUrl?: string;
  ogImage?: string;
  ogSiteName?: string;
  /** 記事内 X 埋め込み用（preconnect のみ。widgets.js はページ側で読み込む） */
  twitterEmbeds?: boolean;
}

const {
  title,
  description = 'atohs(あとーす)のポートフォリオサイトです。メディア運営、執筆・編集、文字起こし、写真撮影、校正などを行っています。',
  ogUrl = 'https://atohs.me',
  ogImage = 'https://atohs.me/src/ogp.png',
  ogSiteName = 'atohs.me',
  twitterEmbeds = false,
} = Astro.props;

await import('../styles/main.css');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        const key = 'atohs-theme';
        const stored = localStorage.getItem(key);
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;

        const contrastKey = 'atohs-contrast';
        const contrastRaw = localStorage.getItem(contrastKey);
        const contrastParsed = contrastRaw ? parseInt(contrastRaw, 10) : 100;
        const contrast =
          contrastParsed >= 75 && contrastParsed <= 125 ? contrastParsed : 100;
        document.documentElement.style.setProperty(
          '--contrast-level',
          String(contrast),
        );
        if (contrast >= 100) {
          const towardHigh = (contrast - 100) / 25;
          document.documentElement.style.setProperty(
            '--contrast-toward-high',
            String(towardHigh),
          );
          document.documentElement.style.setProperty('--contrast-toward-low', '0');
        } else if (contrast < 100) {
          const towardLow = (100 - contrast) / 25;
          document.documentElement.style.setProperty(
            '--contrast-toward-low',
            String(towardLow),
          );
          document.documentElement.style.setProperty('--contrast-toward-high', '0');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@atohsaaa" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={SITE_FAVICON_SRC} />
    <link
      rel="preload"
      href={siteLogoPreload.src}
      as="image"
      type="image/webp"
      fetchpriority="high"
    />
    {
      twitterEmbeds && (
        <>
          <link rel="preconnect" href="https://syndication.twitter.com" />
          <link rel="preconnect" href="https://platform.twitter.com" />
        </>
      )
    }
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-3S8S7JGPEZ');

      function loadGtag() {
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-3S8S7JGPEZ';
        document.head.appendChild(script);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGtag, { timeout: 3500 });
      } else {
        window.addEventListener('load', loadGtag, { once: true });
      }
    </script>
  </head>
  <body class="site">
    <a class="skip-link" href="#main-content">メインコンテンツへスキップ</a>
    <div class="site-content">
      <slot />
    </div>
  </body>
</html>
