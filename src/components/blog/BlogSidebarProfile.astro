---
import SiteLogo from '../SiteLogo.astro';
import { blogSidebarProfile } from '../../data/blog-sidebar-profile';

const { nameJa, nameEn, detailLines, bio } = blogSidebarProfile;
---

<section class="profile-section">
  <h2 class="profile-box-title">Profile</h2>
  <a class="profile-box" href="/about" aria-label="About（自己紹介）へ">
    <div class="name-box">
      <SiteLogo class="profile-icon" loading="eager" fetchpriority="high" decoding="sync" />
      <p class="name-detail">
        <span class="name-primary">
          <span class="name-primary-part">{nameJa}</span>
          <span class="name-primary-part">{nameEn}</span>
        </span>
        {detailLines.map((line) => (
          <span class="name-detail-line">{line}</span>
        ))}
      </p>
    </div>
    <p class="profile-text">{bio}</p>
  </a>
</section>
