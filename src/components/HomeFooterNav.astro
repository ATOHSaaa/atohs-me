  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <a class="home-footer-nav-link" href="/keywords">Keywords</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <a class="home-footer-nav-link" href="/contact">Contact</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <a class="home-footer-nav-link" href="/stats" aria-current={isStats ? 'page' : undefined}>Stats</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <SiteYondaLink variant="home-footer" />
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
