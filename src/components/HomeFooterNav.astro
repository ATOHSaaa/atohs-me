  <a class="home-footer-nav-link" href="/blog">Blog</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <a class="home-footer-nav-link" href="/about">About</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
  <a class="home-footer-nav-link" href="/resume">Resume</a>
  <span class="home-footer-nav-sep" aria-hidden="true">/</span>
