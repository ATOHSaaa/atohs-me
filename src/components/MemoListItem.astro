---
import { formatDate } from '../lib/format-date';
import { memoPagePath } from '../lib/scrapbox/slug';
import type { BuiltMemoPage } from '../lib/scrapbox/types';

interface Props {
  page: BuiltMemoPage;
}

const { page } = Astro.props;
const updatedAt = new Date(page.updated * 1000);
const dateLabel = formatDate(updatedAt);
const isDiaryTitle = /^\d{4}-\d{2}-\d{2}$/.test(page.title);
const linkLabel = isDiaryTitle ? dateLabel : page.title;
---

<li class="blog-list-item">
  <time datetime={updatedAt.toISOString()}>{dateLabel}</time>
  <span class="blog-list-title-wrap">
    <a href={memoPagePath(page.slug)}>{linkLabel}</a>
  </span>
</li>
