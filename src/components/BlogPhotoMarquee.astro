---
import { Image } from 'astro:assets';
import type { BlogPhoto } from '../lib/blog-photos';

interface Props {
  photos: BlogPhoto[];
}

const { photos } = Astro.props;
if (photos.length === 0) return;

const durationSeconds = Math.max(28, photos.length * 5);

/**
 * 表示サイズは `.blog-photo-marquee-item img`（293×187、720px 以下は 235×149）。
 * `sizes` で実寸を伝え、2x 分は 586px までに留める（原寸を超えて拡大しない）。
 */
const imageProps = {
  width: 293,
  height: 187,
  widths: [235, 293, 412, 586],
  sizes: '(max-width: 720px) 235px, 293px',
  fit: 'cover' as const,
  format: 'webp' as const,
  quality: 65,
};

const lazyImageProps = {
  loading: 'lazy' as const,
  decoding: 'async' as const,
};
---

<section
  class="blog-photo-marquee"
  aria-label="ブログ記事の写真"
  style={`--marquee-duration: ${durationSeconds}s`}
>
  <div class="blog-photo-marquee-viewport">
    <div class="blog-photo-marquee-track">
      <ul class="blog-photo-marquee-list">
        {
          photos.map((photo, index) => (
            <li class="blog-photo-marquee-item">
              <a href={`/blog/${photo.postId}`} title={photo.postTitle}>
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  {...imageProps}
                  {...(index === 0 ? { priority: true } : lazyImageProps)}
                />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="blog-photo-marquee-list" aria-hidden="true">
        {
          photos.map((photo) => (
            <li class="blog-photo-marquee-item">
              <a href={`/blog/${photo.postId}`} tabindex="-1">
                <Image src={photo.src} alt="" {...imageProps} {...lazyImageProps} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
