---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SiteLogo from './SiteLogo.astro';
import catImage from '../cat.png';
import { getPublishedBlogPosts, pickRecentBlogPosts } from '../lib/blog-posts';
import { buildBlogStats } from '../lib/blog-stats';
import { formatDate } from '../lib/format-date';

const now = new Date();
const allPosts = await getPublishedBlogPosts();
const stats = buildBlogStats(allPosts, 'all', now);
const statsPreviewWeeks = 11;
const statsHeatmapWeeks = stats.heatmapWeeks.slice(-statsPreviewWeeks);
const formatStat = (n: number) => n.toLocaleString('en-US');
/** カード内に収まる分だけクライアントで切り詰める（上限は全公開記事まで） */
const HOME_BENTO_BLOG_MAX = Math.max(allPosts.length, 1);
const recentBlogPosts = pickRecentBlogPosts(allPosts, HOME_BENTO_BLOG_MAX);
---

<div class="home-bento-layout">
  <aside class="home-bento-sidebar" aria-label="プロフィール">
    <SiteLogo
      class="home-bento-profile-icon"
      decoding="sync"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="home-bento-profile-name">atohs</h1>
    <p class="home-bento-profile-meta">
      <span class="home-bento-profile-meta-ja" lang="ja">
        <span>伊藤</span>
        <span>祥太</span>
      </span>
      （<span class="home-bento-profile-meta-ja" lang="en">
        <span>ITO</span>
        <span>SHOTA</span>
      </span>）
    </p>
    <div class="home-bento-profile-intro">
      <p class="home-bento-profile-detail">
        うちらの代でインターネットをよくしていかなくっちゃ✌️
      </p>
      <p class="home-bento-profile-detail">印刷会社 → ピクシブ → 独立</p>
    </div>
  </aside>

  <div class="home-bento-main">
    <section class="home-bento" aria-label="サイト案内">
  <article class="home-bento-card home-bento-card--blog">
    <a class="home-bento-blog-card-surface" href="/blog/" aria-label="ブログ一覧へ"></a>
    <div class="home-bento-card__inner">
      <div class="home-bento-card__head">
        <span class="home-bento-card__icon" aria-hidden="true">📰</span>
        <span class="home-bento-card__title">Blog</span>
      </div>
      <ul class="home-bento-blog-list" data-home-bento-blog-list aria-label="最近のブログ記事">
        {
          recentBlogPosts.map((post, index) => (
            <li class="home-bento-blog-list__item" hidden={index >= 6}>
              <time
                class="home-bento-blog-list__date"
                datetime={post.data.pubDate.toISOString()}
              >
                {formatDate(post.data.pubDate)}
              </time>
              <a class="home-bento-blog-list__title" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </article>

  <a class="home-bento-card home-bento-card--stats" href="/blog/stats">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__head">
        <span class="home-bento-card__icon" aria-hidden="true">
          <span class="home-bento-card__mark">
            <svg viewBox="0 0 16 16">
              <rect x="1" y="9" width="3.2" height="6" rx="0.8" />
              <rect x="6.4" y="5" width="3.2" height="10" rx="0.8" />
              <rect x="11.8" y="1" width="3.2" height="14" rx="0.8" />
            </svg>
          </span>
        </span>
        <span class="home-bento-card__title">Stats</span>
      </span>
      <span class="home-bento-stats-metrics">
        <span class="home-bento-stats-heading">Blog's stats</span>
        <span class="home-bento-stats-metric">
          <span class="home-bento-stats-metric__label">Total posts</span>
          <span class="home-bento-stats-metric__value">{formatStat(stats.postCount)}</span>
        </span>
        <span class="home-bento-stats-metric">
          <span class="home-bento-stats-metric__label">Total characters</span>
          <span class="home-bento-stats-metric__value">{formatStat(stats.totalCharCount)}</span>
        </span>
      </span>
      <span
        class="home-bento-heatmap"
        style={`--home-bento-heatmap-weeks: ${statsHeatmapWeeks.length}`}
        aria-hidden="true"
      >
        {
          statsHeatmapWeeks.map((week) =>
            week.days
              .filter((day) => !day.outOfRange)
              .map((day) => (
                <span
                  class:list={[
                    'home-bento-heatmap-cell',
                    `home-bento-heatmap-cell--${day.level}`,
                  ]}
                />
              )),
          )
        }
      </span>
    </span>
  </a>

  <div class="home-bento-cat-unit">
    <span class="home-bento-cat-nya" aria-hidden="true">nya〜！</span>
    <button
      type="button"
      class="home-bento-card home-bento-card--cat"
      data-home-bento-cat
      aria-expanded="false"
      aria-label="猫の写真"
    >
      <Image
        class="home-bento-card__photo"
        src={catImage}
        alt=""
        width={720}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 880px) 20cqi, (min-width: 640px) 45cqi, 100cqi"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    </button>
  </div>

  <a class="home-bento-card home-bento-card--about" href="/about">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">👋</span>
      <span class="home-bento-card__title">About</span>
    </span>
  </a>

  <a class="home-bento-card home-bento-card--memo" href="/memo/">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">✍️</span>
      <span class="home-bento-card__title">Memo</span>
    </span>
  </a>

  <a class="home-bento-card home-bento-card--resume" href="/resume">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">📝</span>
      <span class="home-bento-card__title">Resume</span>
    </span>
  </a>

  <a class="home-bento-card home-bento-card--keywords" href="/keywords">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">🙋‍♀️</span>
      <span class="home-bento-card__title">Keywords</span>
    </span>
  </a>

  <a class="home-bento-card home-bento-card--contact" href="/contact">
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">👀</span>
      <span class="home-bento-card__title">Contact</span>
    </span>
  </a>

  <a
    class="home-bento-card home-bento-card--yonda"
    href="https://yonda.tadeku.net/atohs"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">📚️</span>
      <span class="home-bento-card__title">
        Yonda<span class="link-external-mark" aria-hidden="true">↗</span>
      </span>
      <span class="visually-hidden">（新しいタブで開く）</span>
    </span>
  </a>

  <a
    class="home-bento-card home-bento-card--twitter"
    href="https://twitter.com/atohsaaa"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="home-bento-card__inner">
      <span class="home-bento-card__icon" aria-hidden="true">
        <Icon name="twitter" />
      </span>
      <span class="home-bento-card__title">
        Twitter<span class="link-external-mark" aria-hidden="true">↗</span>
      </span>
      <span class="visually-hidden">（新しいタブで開く）</span>
    </span>
  </a>
    </section>
  </div>
</div>

<script>
  function fitHomeBentoBlogList(card: HTMLElement) {
    const inner = card.querySelector<HTMLElement>('.home-bento-card__inner');
    const list = card.querySelector<HTMLUListElement>('[data-home-bento-blog-list]');
    if (!inner || !list) return;

    const items = [...list.querySelectorAll<HTMLLIElement>('.home-bento-blog-list__item')];
    if (items.length === 0) return;

    const maxBottom = () => {
      const innerStyle = getComputedStyle(inner);
      const cardStyle = getComputedStyle(card);
      const padBottom = Number.parseFloat(innerStyle.paddingBottom) || 0;
      const borderBottom = Number.parseFloat(cardStyle.borderBottomWidth) || 0;
      return (
        Math.min(
          inner.getBoundingClientRect().bottom - padBottom,
          card.getBoundingClientRect().bottom - borderBottom,
        ) - 8
      );
    };

    const visibleItemsFit = (visible: number) => {
      const bottom = maxBottom();
      for (let i = 0; i < visible; i += 1) {
        if (items[i].hidden) return false;
        if (items[i].getBoundingClientRect().bottom > bottom) return false;
      }
      return true;
    };

    for (const item of items) {
      item.hidden = true;
    }

    let visible = 0;
    for (let i = 0; i < items.length; i += 1) {
      items[i].hidden = false;
      visible += 1;
      if (!visibleItemsFit(visible)) {
        items[i].hidden = true;
        visible -= 1;
        break;
      }
    }

    while (visible > 0 && !visibleItemsFit(visible)) {
      items[visible - 1].hidden = true;
      visible -= 1;
    }
  }

  function scheduleHomeBentoBlogListFit(card: HTMLElement) {
    const run = () => fitHomeBentoBlogList(card);
    run();
    requestAnimationFrame(() => {
      run();
      requestAnimationFrame(run);
    });
  }

  function initHomeBentoBlogList() {
    document.querySelectorAll<HTMLElement>('.home-bento-card--blog').forEach((card) => {
      const fit = () => scheduleHomeBentoBlogListFit(card);

      if (card.dataset.homeBentoBlogListInit !== 'true') {
        card.dataset.homeBentoBlogListInit = 'true';
        const observer = new ResizeObserver(() => fit());
        observer.observe(card);
        window.addEventListener('resize', fit, { passive: true });
        document.fonts?.ready.then(fit);
      }

      fit();
    });
  }

  function initHomeBentoCat() {
    document
      .querySelectorAll<HTMLButtonElement>('.home-bento-card--cat[data-home-bento-cat]')
      .forEach((button) => {
        if (button.dataset.homeBentoCatInit === 'true') return;
        button.dataset.homeBentoCatInit = 'true';

        let hideTimer: ReturnType<typeof setTimeout> | undefined;

        button.addEventListener('click', () => {
          const unit = button.closest('.home-bento-cat-unit');
          if (!unit) return;
          const nya = unit.querySelector('.home-bento-cat-nya');

          if (hideTimer !== undefined) clearTimeout(hideTimer);

          unit.classList.add('is-nya-visible');
          button.setAttribute('aria-expanded', 'true');
          nya?.setAttribute('aria-hidden', 'false');

          hideTimer = setTimeout(() => {
            unit.classList.remove('is-nya-visible');
            button.setAttribute('aria-expanded', 'false');
            nya?.setAttribute('aria-hidden', 'true');
            hideTimer = undefined;
          }, 2000);
        });
      });
  }

  initHomeBentoBlogList();
  initHomeBentoCat();
  document.addEventListener('astro:page-load', () => {
    initHomeBentoBlogList();
    initHomeBentoCat();
  });
</script>