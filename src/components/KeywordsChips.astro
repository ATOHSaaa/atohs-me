---
import { getKeywordEntries, keywordHref } from '../lib/keywords';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const entries = await getKeywordEntries();
---

<ul class="keywords-list">
  {
    entries.map((entry) => {
      const isCurrent = entry.id === currentSlug;
      return (
        <li>
          {isCurrent ? (
            <span class="keywords-chip keywords-chip--current" aria-current="page">
              <span class="keywords-chip-label">{entry.data.title}</span>
            </span>
          ) : (
            <a class="keywords-chip" href={keywordHref(entry.id)}>
              <span class="keywords-chip-label">{entry.data.title}</span>
            </a>
          )}
        </li>
      );
    })
  }
</ul>
