---
import KeywordsChips from './KeywordsChips.astro';
import KeywordsRandomButton from './KeywordsRandomButton.astro';
import { getKeywordEntries } from '../lib/keywords';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const hasKeywords = (await getKeywordEntries()).length > 0;
---

{
  hasKeywords && (
    <section class="keywords-other" aria-labelledby="keywords-other-heading">
      <div class="keywords-heading-row">
        <h2 id="keywords-other-heading" class="keywords-heading">Keywords</h2>
        <KeywordsRandomButton excludeSlug={currentSlug} />
      </div>
      <KeywordsChips currentSlug={currentSlug} />
    </section>
  )
}
