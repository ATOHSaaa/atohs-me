---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  image?: ImageMetadata;
  external?: boolean;
}

const { title, description, href, image, external = false } = Astro.props;
---

<div class="item">
  <a
    class="item-link"
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {
      image ? (
        <Image
          src={image}
          alt=""
          width={720}
          widths={[240, 360, 480, 720]}
          sizes="(max-width: 639px) calc(100vw - 32px), (max-width: 899px) 352px, (max-width: 1079px) 229px, 168px"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      ) : null
    }
    <h3>{title}</h3>
    {external && <span class="visually-hidden">（新しいタブで開く）</span>}
  </a>
  <span>{description}</span>
</div>
