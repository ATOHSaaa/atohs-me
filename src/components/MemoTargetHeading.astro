---
import type { ResolvedMemoTarget } from '../lib/scrapbox/link-context';

interface Props {
  target: ResolvedMemoTarget;
}

const { target } = Astro.props;
---

<h3 class="memo-hop-heading">
  {
    target.href && (target.kind === 'page' || target.kind === 'tag') ? (
      <a class="memo-link" href={target.href}>
        {target.kind === 'tag' ? `#${target.display}` : target.display}
      </a>
    ) : (
      <span>{target.display}</span>
    )
  }
</h3>
