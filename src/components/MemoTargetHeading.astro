---
import type { ResolvedMemoTarget } from '../lib/scrapbox/link-context';

interface Props {
  target: ResolvedMemoTarget;
}

const { target } = Astro.props;
---

<h3 class="memo-hop-heading">
  {
    target.kind === 'page' && target.href ? (
      <a href={target.href}>{target.display}</a>
    ) : target.kind === 'tag' && target.href ? (
      <a class="memo-hop-heading-tag" href={target.href}>#{target.display}</a>
    ) : (
      <span class="memo-empty-link">{target.display}</span>
    )
  }
</h3>
