---
import { formatAgeYears } from '../lib/age-since-birth';

const initialText = formatAgeYears();
---

<span data-profile-age>{initialText}</span>

<script>
  import { formatAgeYears } from '../lib/age-since-birth';

  function updateProfileAgeLines() {
    const text = formatAgeYears();
    document.querySelectorAll('[data-profile-age]').forEach((el) => {
      el.textContent = text;
    });
  }

  updateProfileAgeLines();
  document.addEventListener('astro:page-load', updateProfileAgeLines);
</script>
