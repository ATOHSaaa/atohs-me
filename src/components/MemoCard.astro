---
import { formatDate } from '../lib/format-date';
import { memoPagePath } from '../lib/scrapbox/slug';
import type { BuiltMemoPage } from '../lib/scrapbox/types';

interface Props {
  page: BuiltMemoPage;
  compact?: boolean;
}

const { page, compact = false } = Astro.props;
const updatedAt = new Date(page.updated * 1000);
const href = memoPagePath(page.slug);
---

<div class:list={['item', 'memo-card', compact && 'memo-card--compact']}>
  <a class="item-link memo-card-link" href={href}>
    {
      page.thumbnailUrl ? (
        <div class="memo-card-media">
          <img
            src={page.thumbnailUrl}
            alt=""
            width={640}
            height={360}
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : null
    }
    <div class="memo-card-text">
      <time class="memo-card-date" datetime={updatedAt.toISOString()}>
        {formatDate(updatedAt)}
      </time>
      <h3 class="memo-card-title">{page.title}</h3>
      <p class="memo-card-excerpt">{page.excerpt}</p>
    </div>
  </a>
</div>
