---
import { iconSvg } from '../lib/icons';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const linkIconHtml = iconSvg('link', 'share-button-icon');
const checkIconHtml = iconSvg('check', 'share-button-icon');
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(`${title}\n`);
const hatenaUrl = `https://b.hatena.ne.jp/entry/panel/?url=${encodedUrl}`;
const xUrl = `https://x.com/intent/post?text=${encodedTitle}&url=${encodedUrl}`;
---

<div class="share-buttons">
  <a
    class="share-button share-hatena"
    href={hatenaUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="はてなブックマークに追加（新しいタブで開く）"
  >
    <span class="share-button-face"><span class="share-button-mark">B!</span></span>
  </a>
  <a
    class="share-button share-x"
    href={xUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Xでシェア（新しいタブで開く）"
  >
    <span class="share-button-face"><span class="share-button-mark">X</span></span>
  </a>
  <button
    type="button"
    class="share-button share-link"
    data-share-url={url}
    aria-label="リンクをコピー"
  >
    <span class="share-button-face" set:html={linkIconHtml} />
  </button>
</div>

<script define:vars={{ checkIconHtml }}>
  document.querySelectorAll('.share-link').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.shareUrl;
      if (!url) return;

      const face = button.querySelector('.share-button-face');
      const originalLabel = button.getAttribute('aria-label') ?? 'リンクをコピー';
      const originalContent = face?.innerHTML ?? button.innerHTML;

      try {
        await navigator.clipboard.writeText(url);
        if (face) {
          face.innerHTML = checkIconHtml;
        } else {
          button.innerHTML = checkIconHtml;
        }
        button.setAttribute('aria-label', 'リンクをコピーしました');
      } catch {
        window.prompt('リンクをコピーしてください', url);
        return;
      }

      window.setTimeout(() => {
        if (face) {
          face.innerHTML = originalContent;
        } else {
          button.innerHTML = originalContent;
        }
        button.setAttribute('aria-label', originalLabel);
      }, 1500);
    });
  });
</script>
