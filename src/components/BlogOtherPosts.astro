---
import type { BlogPostEntry } from '../lib/blog-posts';
import BlogListItem from './BlogListItem.astro';

interface Props {
  posts: BlogPostEntry[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="blog-other-posts" aria-labelledby="blog-other-posts-heading">
      <h2 id="blog-other-posts-heading" class="blog-other-posts-heading">最近書いた記事</h2>
      <ul class="blog-list blog-other-posts-list">
        {posts.map((post) => (
          <BlogListItem post={post} />
        ))}
      </ul>
    </section>
  )
}
