---
import type { BlogPostEntry } from '../lib/blog-posts';
import { formatDate, formatRelativePublishLabel } from '../lib/format-date';

interface Props {
  post: BlogPostEntry;
  showNew?: boolean;
  showRelativeDate?: boolean;
  /** トップの直近一覧用（日付列の subgrid を揃える） */
  homeRecentList?: boolean;
}

const {
  post,
  showNew = false,
  showRelativeDate = false,
  homeRecentList = false,
} = Astro.props;
const dateLabel = showRelativeDate
  ? formatRelativePublishLabel(post.data.pubDate)
  : formatDate(post.data.pubDate);
---

<li
  class:list={[
    'blog-list-item',
    (showRelativeDate || homeRecentList) && 'blog-list-item--relative-date',
  ]}
>
  {showNew && <span class="blog-list-new" aria-hidden="true">NEW</span>}
  {
    homeRecentList || showRelativeDate ? (
      <time class="blog-list-date" datetime={post.data.pubDate.toISOString()}>
        {dateLabel}
      </time>
    ) : (
      <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
    )
  }
  <span class="blog-list-title-wrap">
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
  </span>
</li>
