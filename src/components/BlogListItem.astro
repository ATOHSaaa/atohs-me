---
import type { BlogPostEntry } from '../lib/blog-posts';
import { formatDate, formatRelativePublishLabel } from '../lib/format-date';

interface Props {
  post: BlogPostEntry;
  showNew?: boolean;
  showRelativeDate?: boolean;
}

const { post, showNew = false, showRelativeDate = false } = Astro.props;
const relativeLabel = showRelativeDate ? formatRelativePublishLabel(post.data.pubDate) : null;
---

<li class="blog-list-item">
  {showNew && <span class="blog-list-new" aria-hidden="true">NEW</span>}
  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  <span class="blog-list-title-wrap">
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
    {relativeLabel && <span class="blog-list-relative">{relativeLabel}</span>}
  </span>
</li>
