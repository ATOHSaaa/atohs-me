---
import type { BlogPostEntry } from '../lib/blog-posts';
import { formatDate, formatRelativePublishLabel } from '../lib/format-date';

interface Props {
  post: BlogPostEntry;
  showNew?: boolean;
  showRelativeDate?: boolean;
}

const { post, showNew = false, showRelativeDate = false } = Astro.props;
const relativeLabel = showRelativeDate
  ? formatRelativePublishLabel(post.data.pubDate)
  : null;
---

<li
  class:list={['blog-list-item', showRelativeDate && 'blog-list-item--relative-date']}
>
  {showNew && <span class="blog-list-new" aria-hidden="true">NEW</span>}
  {
    relativeLabel ? (
      <time class="blog-list-date" datetime={post.data.pubDate.toISOString()}>
        {relativeLabel}
      </time>
    ) : (
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    )
  }
  <span class="blog-list-title-wrap">
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
  </span>
</li>
