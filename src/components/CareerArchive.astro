---
import CareerArchiveList from './CareerArchiveList.astro';
import type { CareerSection } from '../lib/career-tree';
import { inlineMarkdownToHtml } from '../lib/career-tree';

interface Props {
  sections: CareerSection[];
}

const { sections } = Astro.props;
---

<div class="blog-archive-tree career-archive-tree">
  {
    sections.map((section) => (
      <details class="blog-archive-node blog-archive-node--year" open>
        <summary class="blog-archive-toggle" aria-label={`${section.title}を開閉`}>
          <span class="blog-archive-chevron" aria-hidden="true" />
          <span class="blog-archive-label blog-archive-label--year">{section.title}</span>
        </summary>
        <div class="blog-archive-children">
          {
            section.items.length > 0 && (
              <div
                class:list={[
                  'blog-archive-children--leaves',
                  'career-archive-section-leaves',
                  { 'career-archive-section-leaves--before-subsections': section.subsections.length > 0 },
                ]}
              >
                <CareerArchiveList items={section.items} />
              </div>
            )
          }
          {
            section.subsections.map((subsection) => (
              <details class="blog-archive-node blog-archive-node--month" open>
                <summary class="blog-archive-toggle" aria-label={`${subsection.title}を開閉`}>
                  <span class="blog-archive-chevron" aria-hidden="true" />
                  <span
                    class="blog-archive-label blog-archive-label--month career-archive-label--month"
                    role="heading"
                    aria-level="3"
                    set:html={inlineMarkdownToHtml(subsection.title)}
                  />
                </summary>
                <div class="blog-archive-children blog-archive-children--leaves">
                  <CareerArchiveList items={subsection.items} />
                </div>
              </details>
            ))
          }
        </div>
      </details>
    ))
  }
</div>

<script>
  function initCareerArchiveSummaryLinks() {
    document
      .querySelectorAll('.career-archive-tree .blog-archive-label a')
      .forEach((link) => {
        if (link.dataset.bound === 'true') return;
        link.dataset.bound = 'true';
        link.addEventListener('click', (event) => event.stopPropagation());
      });
  }

  initCareerArchiveSummaryLinks();
  document.addEventListener('astro:page-load', initCareerArchiveSummaryLinks);
</script>
