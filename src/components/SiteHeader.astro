---
import { SITE_LOGO_SRC } from '../lib/site-logo';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const pathname = Astro.url.pathname;
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isWorks = pathname === '/works' || pathname.startsWith('/works/');
const isCareer = pathname === '/my-business-experience';
const isContact = pathname === '/contact';

const LogoTag = isHome ? 'h1' : 'p';
---

<header class="header-top">
  <div class="header-inner">
    <LogoTag class="header-logo">
      <a href="/">
        <img
          class="header-logo-icon"
          src={SITE_LOGO_SRC}
          alt=""
          width="28"
          height="28"
          decoding="sync"
          loading="eager"
          fetchpriority="high"
          transition:persist="site-logo"
        />
        atohs.me
      </a>
    </LogoTag>
    <nav class="header-links" aria-label="メニュー">
      <a class="header-link" href="/blog" aria-current={isBlog ? 'page' : undefined}>Blog</a>
      <a class="header-link" href="/works" aria-current={isWorks ? 'page' : undefined}>Works</a>
      <a class="header-link" href="/my-business-experience" aria-current={isCareer ? 'page' : undefined}>Career</a>
      <a class="header-link" href="/contact" aria-current={isContact ? 'page' : undefined}>Contact</a>
      <a
        class="header-link header-social"
        href="https://twitter.com/atohsaaa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Twitter @atohsaaa（新しいタブで開く）"
      >
        <i class="fab fa-twitter" aria-hidden="true"></i>
      </a>
    </nav>
  </div>
</header>
