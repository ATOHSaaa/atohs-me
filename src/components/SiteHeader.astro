---
import HeaderNavLabel from './HeaderNavLabel.astro';
import SiteTwitterLink from './SiteTwitterLink.astro';
import SiteYondaLink from './SiteYondaLink.astro';
import ContrastSlider from './ContrastSlider.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isWorks = pathname === '/works' || pathname.startsWith('/works/');
const isContact = pathname === '/contact';
const isKeywords = pathname === '/keywords' || pathname.startsWith('/keywords/');
const isAbout = pathname === '/about';
const isResume = pathname === '/resume';
---

<header class="header-top">
  <div class="header-inner">
    <p class="header-logo">
      <a href="/">atohs.me</a>
    </p>
    <div class="header-end">
      <div class="header-display-controls">
        <ContrastSlider />
        <ThemeToggle />
      </div>
      <nav id="header-menu" class="header-links" aria-label="メニュー">
        <a
          class="header-link"
          style="--title-line-count: 1"
          href="/blog"
          aria-current={isBlog ? 'page' : undefined}
        >
          <HeaderNavLabel label="Blog" />
        </a>
        <details class="header-info">
          <summary class="header-info-toggle" style="--title-line-count: 1">
            <HeaderNavLabel label="Info" />
            <span class="header-info-chevron" aria-hidden="true"></span>
          </summary>
          <div class="header-info-panel">
            <a
              class="header-link"
              style="--title-line-count: 1"
              href="/about"
              aria-current={isAbout ? 'page' : undefined}
            >
              <HeaderNavLabel label="About" />
            </a>
            <a
              class="header-link"
              style="--title-line-count: 1"
              href="/resume"
              aria-current={isResume ? 'page' : undefined}
            >
              <HeaderNavLabel label="Resume" />
            </a>
            <a
              class="header-link"
              style="--title-line-count: 1"
              href="/works"
              aria-current={isWorks ? 'page' : undefined}
            >
              <HeaderNavLabel label="Works" />
            </a>
            <a
              class="header-link"
              style="--title-line-count: 1"
              href="/keywords"
              aria-current={isKeywords ? 'page' : undefined}
            >
              <HeaderNavLabel label="Keywords" />
            </a>
          </div>
        </details>
        <a
          class="header-link"
          style="--title-line-count: 1"
          href="/contact"
          aria-current={isContact ? 'page' : undefined}
        >
          <HeaderNavLabel label="Contact" />
        </a>
        <SiteYondaLink variant="header" />
        <SiteTwitterLink variant="header" />
      </nav>
      <button
        type="button"
        class="header-menu-toggle"
        aria-expanded="false"
        aria-controls="header-menu"
        aria-label="メニューを開く"
      >
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <button
    type="button"
    class="header-menu-backdrop"
    aria-label="メニューを閉じる"
    tabindex="-1"
  ></button>
</header>

<script>
  function initHeaderMenu() {
    const header = document.querySelector('.header-top');
    const toggle = document.querySelector('.header-menu-toggle');
    const backdrop = document.querySelector('.header-menu-backdrop');
    const menu = document.getElementById('header-menu');
    if (!header || !toggle || !menu) return;

    const mobileHeaderMq = window.matchMedia('(max-width: 720px)');

    const closeMenu = () => {
      header.classList.remove('is-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'メニューを開く');
      header.querySelector('details.header-info')?.removeAttribute('open');
    };

    const openMenu = () => {
      header.classList.add('is-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'メニューを閉じる');
      const info = header.querySelector('details.header-info');
      if (info && mobileHeaderMq.matches) {
        info.setAttribute('open', '');
      }
    };

    if (toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      if (header.classList.contains('is-menu-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    backdrop?.addEventListener('click', closeMenu);
  }

  initHeaderMenu();
  document.addEventListener('astro:page-load', initHeaderMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const header = document.querySelector('.header-top');
    const menuToggle = document.querySelector('.header-menu-toggle');
    if (!header?.classList.contains('is-menu-open') || !menuToggle) return;
    header.classList.remove('is-menu-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'メニューを開く');
    header.querySelector('details.header-info')?.removeAttribute('open');
  });
</script>
