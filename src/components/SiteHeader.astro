---
import SiteLogo from './SiteLogo.astro';
import SiteTwitterLink from './SiteTwitterLink.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const pathname = Astro.url.pathname;
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
const isWorks = pathname === '/works' || pathname.startsWith('/works/');
const isContact = pathname === '/contact';
const isKeywords = pathname === '/keywords' || pathname.startsWith('/keywords/');
const isResume = pathname === '/resume';
const LogoTag = isHome ? 'h1' : 'p';
---

<header class="header-top">
  <div class="header-inner">
    <LogoTag class="header-logo">
      <a href="/">
        <SiteLogo
          class="header-logo-icon"
          decoding="sync"
          loading="eager"
          fetchpriority="high"
        />
        atohs.me
      </a>
    </LogoTag>
    <div class="header-end">
      <ThemeToggle />
      <nav id="header-menu" class="header-links" aria-label="メニュー">
        <a class="header-link" href="/blog" aria-current={isBlog ? 'page' : undefined}>Blog</a>
        <div class="header-info">
          <button
            type="button"
            class="header-info-toggle"
            aria-expanded="false"
            aria-controls="header-info-panel"
            data-header-info-toggle
          >
            Info
            <span class="header-info-chevron" aria-hidden="true"></span>
          </button>
          <div id="header-info-panel" class="header-info-panel" hidden>
            <a class="header-link" href="/resume" aria-current={isResume ? 'page' : undefined}>Resume</a>
            <a class="header-link" href="/works" aria-current={isWorks ? 'page' : undefined}>Works</a>
            <a class="header-link" href="/keywords" aria-current={isKeywords ? 'page' : undefined}>Keywords</a>
          </div>
        </div>
        <a class="header-link" href="/contact" aria-current={isContact ? 'page' : undefined}>Contact</a>
        <SiteTwitterLink variant="header" />
      </nav>
      <button
        type="button"
        class="header-menu-toggle"
        aria-expanded="false"
        aria-controls="header-menu"
        aria-label="メニューを開く"
      >
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
        <span class="header-menu-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <button
    type="button"
    class="header-menu-backdrop"
    aria-label="メニューを閉じる"
    tabindex="-1"
  ></button>
</header>

<script>
  function initHeaderMenu() {
    const header = document.querySelector('.header-top');
    const toggle = document.querySelector('.header-menu-toggle');
    const backdrop = document.querySelector('.header-menu-backdrop');
    const menu = document.getElementById('header-menu');
    if (!header || !toggle || !menu) return;

    const closeMenu = () => {
      header.classList.remove('is-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'メニューを開く');
      closeHeaderInfo();
    };

    const openMenu = () => {
      header.classList.add('is-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'メニューを閉じる');
    };

    if (toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      if (header.classList.contains('is-menu-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    backdrop?.addEventListener('click', closeMenu);
  }

  function closeHeaderInfo() {
    const info = document.querySelector('.header-info');
    const toggle = document.querySelector('[data-header-info-toggle]');
    const panel = document.getElementById('header-info-panel');
    if (!info || !toggle || !panel) return;
    info.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
  }

  function initHeaderInfo() {
    const info = document.querySelector('.header-info');
    const toggle = document.querySelector('[data-header-info-toggle]');
    const panel = document.getElementById('header-info-panel');
    if (!info || !toggle || !panel) return;

    const closeInfo = () => closeHeaderInfo();

    const openInfo = () => {
      info.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    };

    if (info.dataset.bound === 'true') return;
    info.dataset.bound = 'true';

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      if (info.classList.contains('is-open')) {
        closeInfo();
      } else {
        openInfo();
      }
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeInfo);
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!info.contains(event.target)) closeInfo();
    });
  }

  initHeaderMenu();
  initHeaderInfo();
  document.addEventListener('astro:page-load', () => {
    initHeaderMenu();
    initHeaderInfo();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const header = document.querySelector('.header-top');
    const menuToggle = document.querySelector('.header-menu-toggle');
    const info = document.querySelector('.header-info');

    if (info?.classList.contains('is-open')) {
      closeHeaderInfo();
      return;
    }

    if (!header?.classList.contains('is-menu-open') || !menuToggle) return;
    header.classList.remove('is-menu-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'メニューを開く');
  });
</script>
