---
import { getBlogPostsPublishedWithinDays } from '../lib/blog-posts';
import BlogListItem from './BlogListItem.astro';

const posts = await getBlogPostsPublishedWithinDays(7);
---

{
  posts.length > 0 && (
    <section class="home-recent-blog" aria-label="直近1週間のブログ記事">
      <ul class="blog-list home-recent-blog-list">
        {posts.map((post) => (
          <BlogListItem post={post} showNew />
        ))}
      </ul>
    </section>
  )
}
