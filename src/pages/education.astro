---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const education = await getEntry('career', 'education');
if (!education) {
  throw new Error('Education content not found');
}
const { Content } = await render(education);
---

<BaseLayout title={`${education.data.title} | atohs.me`} ogUrl="https://atohs.me/education">
  <SiteHeader />
  <main id="main-content" class="main experience">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="page-title">{education.data.title}</h1>
    <div class="experience-body">
      <Content />
    </div>
  </main>
</BaseLayout>
