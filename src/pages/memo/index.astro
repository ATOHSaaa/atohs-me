---
import '../../styles/memo.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MemoCard from '../../components/MemoCard.astro';
import { loadMemosForBuild } from '../../lib/scrapbox/load-memos';

const { pages } = await loadMemosForBuild();
---

<BaseLayout
  title="Memo | atohs.me"
  description="Scrapbox（Cosense）からビルド時に同期したメモ一覧です。"
  ogUrl="https://atohs.me/memo/"
  robotsNoindex={true}
>
  <SiteHeader />
  <main id="main-content" class="main main--memo-index">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="blog-title">Memo</h1>
    <p class="memo-index-lead">
      公開 Scrapbox プロジェクトの内容をビルド時に取り込んで表示しています。検索エンジンには載せない設定（noindex）です。
    </p>
    {
      pages.length === 0 ? (
        <p>表示できるメモはありません。</p>
      ) : (
        <div class="container memo-index-grid">
          {pages.map((page) => (
            <MemoCard page={page} />
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
