---
import '../../styles/memo.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { formatJstDateKey } from '../../lib/format-date';
import { loadMemosForBuild } from '../../lib/scrapbox/load-memos';
import { memoPagePath, memoRouteParam } from '../../lib/scrapbox/slug';
import { MEMO_OG_IMAGE_URL } from '../../lib/memo-og';
import MemoPageLinks from '../../components/MemoPageLinks.astro';
import MemoSidebarKeywords from '../../components/MemoSidebarKeywords.astro';

export async function getStaticPaths() {
  const result = await loadMemosForBuild();
  return result.pages.map((page) => ({
    params: { slug: memoRouteParam(page.slug) },
    props: { page, build: { pages: result.pages } },
    cacheKey: page.cacheKey,
  }));
}

const { page, build } = Astro.props;
const createdAt = new Date(page.created * 1000);
const updatedAt = new Date(page.updated * 1000);
const publishedLabel = formatJstDateKey(createdAt);
const updatedLabel = formatJstDateKey(updatedAt);
const pageUrl = new URL(memoPagePath(page.slug), 'https://atohs.me').href;
const isKeywordStub = page.keywordStub === true;
const hasBody = !isKeywordStub && page.bodyHtml.trim().length > 0;

---

<BaseLayout
  title={`${page.title} | Memo | atohs.me`}
  description={page.excerpt}
  ogUrl={pageUrl}
  ogImage={MEMO_OG_IMAGE_URL}
  schemaHeadline={page.title}
  datePublished={isKeywordStub ? undefined : createdAt.toISOString()}
  dateModified={isKeywordStub ? undefined : updatedAt.toISOString()}
>
  <SiteHeader />
  <main id="main-content" class="main blog-main memo-main">
    <article class="blog-layout memo-layout">
      <div class="blog-layout-intro">
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <a href="/">Home</a><span class="breadcrumb-slash">/</span>
          <a href="/memo/">memo</a><span class="breadcrumb-slash">/</span>
        </nav>
        <h1 class="blog-title">{page.title}</h1>
        {
          isKeywordStub ? (
            <p class="blog-meta memo-meta">
              <span class="memo-meta-item">
                published:
                <span class="memo-meta-none">none</span>
              </span>
            </p>
          ) : (
            <p class="blog-meta memo-meta">
              <span class="memo-meta-item">
                published:
                <time datetime={publishedLabel}>{publishedLabel}</time>
              </span>
              <span class="memo-meta-item">
                updated:
                <time datetime={updatedLabel}>{updatedLabel}</time>
              </span>
            </p>
          )
        }
      </div>
      <div class="blog-layout-share-rail memo-layout-share-rail" aria-hidden="true"></div>
      {
        hasBody ? (
          <div class="blog-body memo-body" set:html={page.bodyHtml} />
        ) : (
          <div class="memo-body memo-body--empty" aria-hidden="true" />
        )
      }
      <aside class="blog-sidebar memo-sidebar" aria-label="単語リンク">
        <MemoSidebarKeywords targets={page.linkedTargets} />
      </aside>
      <div class="memo-layout-footer">
        <MemoPageLinks page={page} build={build} keywordStub={isKeywordStub} />
      </div>
    </article>
  </main>
</BaseLayout>
