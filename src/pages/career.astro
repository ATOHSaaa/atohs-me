---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CareerArchive from '../components/CareerArchive.astro';
import { parseCareerBody } from '../lib/career-tree';

const career = await getEntry('career', 'index');
if (!career) {
  throw new Error('Career content not found');
}
const sections = parseCareerBody(career.body ?? '');
---

<BaseLayout title={`${career.data.title} | atohs.me`} ogUrl="https://atohs.me/career">
  <SiteHeader />
  <main id="main-content" class="main experience">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="page-title">{career.data.title}</h1>
    <CareerArchive sections={sections} />
  </main>
</BaseLayout>
