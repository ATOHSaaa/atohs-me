---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const career = await getEntry('career', 'index');
if (!career) {
  throw new Error('Career content not found');
}
const { Content } = await render(career);
---

<BaseLayout title={`${career.data.title} | atohs.me`} ogUrl="https://atohs.me/career">
  <SiteHeader />
  <main id="main-content" class="main experience">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="page-title">{career.data.title}</h1>
    <div class="experience-body">
      <Content />
    </div>
  </main>
</BaseLayout>
