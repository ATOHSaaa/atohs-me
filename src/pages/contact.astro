---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout
  title="Contact | atohs.me"
  description="atohs(あとーす)へのお問い合わせはこちらから。"
  ogUrl="https://atohs.me/contact"
>
  <SiteHeader />
  <main id="main-content" class="main">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="page-title">Contact</h1>
    <p>
      <a
        href="mailto:info@tadeku.net"
        target="_blank"
        rel="noopener noreferrer"
        >info@tadeku.net<span class="visually-hidden">（新しいタブで開く）</span></a
      >にメールをお送りいただくか、<a
        href="https://twitter.com/atohsaaa"
        target="_blank"
        rel="noopener noreferrer"
        >TwitterのDM<span class="visually-hidden">（新しいタブで開く）</span></a
      >でお声がけください。
    </p>
  </main>
</BaseLayout>
