---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Keywords from '../components/Keywords.astro';
---

<BaseLayout title="atohs.me | あとーすのプロフィール">
  <SiteHeader isHome />
  <main id="main-content" class="main main-home">
    <div class="home-profile">
      <div class="name-box">
        <img class="profile-icon" src="/src/favicon.ico" alt="" width="128" height="128" />
        <div class="name-body">
          <p class="name-detail">
            <span class="name-detail-line name-primary">あとーす（atohs）, 伊藤祥太（ITO SHOTA）</span>
            <span class="name-detail-line">Born on November 13, 1993 🎉 / Live in Kumamoto 🧸</span>
            <span class="name-detail-line">Website Development / Web Marketing / Writing / Editing</span>
          </p>
        </div>
      </div>
    </div>

    <nav class="home-links" aria-label="サイトメニュー">
      <a class="home-link" href="/blog">Blog</a><span class="home-links-sep" aria-hidden="true">/</span>
      <a class="home-link" href="/my-business-experience">Career</a><span class="home-links-sep" aria-hidden="true">/</span>
      <a class="home-link" href="/works">Works</a><span class="home-links-sep" aria-hidden="true">/</span>
      <a class="home-link" href="/contact">Contact</a>
    </nav>

    <div class="home-blocks">
      <section class="home-block home-block--card" aria-labelledby="home-education-heading">
        <h2 id="home-education-heading" class="home-section-heading">Education</h2>
        <ul class="home-block-list">
          <li>Bachelor of Literature, Kumamoto University, Graduated: March 2016</li>
        </ul>
      </section>

      <section class="home-block home-block--card" aria-labelledby="home-qualification-heading">
        <h2 id="home-qualification-heading" class="home-section-heading">Qualification</h2>
        <ul class="home-block-list">
          <li>1st grade Driver's License</li>
        </ul>
      </section>
    </div>

    <Keywords />
  </main>
</BaseLayout>
