---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HomeRecentBlogPosts from '../components/HomeRecentBlogPosts.astro';
---

<BaseLayout title="atohs.me | あとーすのプロフィール">
  <SiteHeader isHome />
  <main id="main-content" class="main main-home">
    <div class="home-profile">
      <div class="name-body">
        <p class="name-detail">
          <span class="name-detail-line name-primary">
            <span class="name-primary-part">あとーす（atohs）</span>
            <span class="name-primary-part">伊藤祥太（ITO SHOTA）</span>
          </span>
          <span class="name-detail-line">
            Born on November 13, 1993 / Live in Kumamoto
          </span>
          <span class="name-detail-line">Website Development / Web Marketing / Writing / Editing</span>
        </p>
      </div>
    </div>

    <div class="home-blocks">
      <a class="home-block--card" href="/resume#education">
        <h2 class="home-section-heading">Education</h2>
        <ul class="home-block-list">
          <li>Bachelor of Literature, Kumamoto University, Graduated: March 2016</li>
        </ul>
      </a>

      <a class="home-block--card" href="/resume#career">
        <h2 class="home-section-heading">Career</h2>
        <ul class="home-block-list">
          <li>2016.04〜2018.03：Printing Company</li>
          <li>2018.04〜2021.08：pixiv Inc.</li>
          <li>2021.09〜Current：Freelance</li>
        </ul>
      </a>

      <a class="home-block--card" href="/resume#qualification">
        <h2 class="home-section-heading">Qualification</h2>
        <ul class="home-block-list">
          <li>1st grade Driver's License</li>
        </ul>
      </a>
    </div>

    <HomeRecentBlogPosts />
  </main>
</BaseLayout>
