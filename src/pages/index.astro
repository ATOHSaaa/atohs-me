---
import '../styles/home-bento.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HomeBento from '../components/HomeBento.astro';
import { HOME_OG_IMAGE_URL } from '../lib/home-og';
---

<BaseLayout
  title="atohs.me | あとーすのプロフィール"
  ogUrl="https://atohs.me/"
  ogImage={HOME_OG_IMAGE_URL}
>
  <SiteHeader />
  <div class="home-layout">
    <main id="main-content" class="main main-home">
      <HomeBento />
    </main>
  </div>
</BaseLayout>
