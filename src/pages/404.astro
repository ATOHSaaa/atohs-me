---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RecentBlogPosts from '../components/RecentBlogPosts.astro';
import { getPublishedBlogPosts, pickRecentBlogPosts } from '../lib/blog-posts';

const latestPosts = pickRecentBlogPosts(await getPublishedBlogPosts());
---

<BaseLayout
  title="ページが見つかりません | atohs.me"
  description="お探しのページは見つかりませんでした。"
  ogUrl="https://atohs.me/404"
>
  <SiteHeader />
  <main id="main-content" class="main not-found">
    <div class="not-found-hero">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 class="not-found-title">このページはないみたいです</h1>
      <p class="not-found-text">
        URLが間違っているか、もう消えたページかもしれません。<br />
        ホームに戻るか、下の記事から探してみてください。
      </p>
      <div class="not-found-actions">
        <a class="not-found-button" href="/">ホームへ戻る</a>
      </div>
    </div>
    <RecentBlogPosts posts={latestPosts} />
  </main>
</BaseLayout>
