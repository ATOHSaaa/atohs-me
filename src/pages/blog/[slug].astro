---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import BlogSidebarProfile from '../../components/blog/BlogSidebarProfile.astro';
import ProfileBox from '../../components/ProfileBox.astro';
import BlogToc from '../../components/BlogToc.astro';
import BlogOtherPosts from '../../components/BlogOtherPosts.astro';
import BlogPostTags from '../../components/BlogPostTags.astro';
import BlogQuoteFootnotes from '../../components/BlogQuoteFootnotes.astro';
import { extractFootnotesFromMarkdown } from '../../lib/blog-footnotes.js';
import { createPostDescription } from '../../lib/post-description';
import { extractBlogTocItems } from '../../lib/blog-toc';
import { getOtherBlogPosts } from '../../lib/blog-posts';
import { formatDate } from '../../lib/format-date';
import { postHasTwitterEmbed } from '../../lib/blog-twitter-embed.js';
import { OG_IMAGE_FILENAME } from '../../lib/og-image';

await import('../../styles/blog-post.css');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postUrl = `https://atohs.me/blog/${post.id}`;
const ogImage = `https://atohs.me/blog/${post.id}/${OG_IMAGE_FILENAME}`;
const description = createPostDescription(post.body ?? '');
const tocItems = extractBlogTocItems(post.body ?? '');
const otherPosts = await getOtherBlogPosts(post.id, 5);
const hasTwitterEmbed = postHasTwitterEmbed(post.body);
const footnotes = extractFootnotesFromMarkdown(post.body ?? '');
---

<BlogLayout
  title={`${post.data.title} | atohs.me`}
  description={description}
  ogUrl={postUrl}
  ogImage={ogImage}
  twitterEmbeds={hasTwitterEmbed}
>
  <SiteHeader />
  <main id="main-content" class="main blog-main">
    <article class="blog-layout">
      <div class="blog-layout-intro">
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <a href="/">Home</a><span class="breadcrumb-slash">/</span><a href="/blog">Blog</a><span
            class="breadcrumb-slash">/</span>
        </nav>
        <h1 class="blog-title">{post.data.title}</h1>
        <div class="blog-intro-meta">
          {
            post.data.tags.length > 0 && (
              <div class="blog-intro-tags">
                <BlogPostTags tags={post.data.tags} />
              </div>
            )
          }
          <p class="blog-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </p>
        </div>
      </div>
      <div class="blog-layout-share-rail">
        <ShareButtons url={postUrl} title={post.data.title} />
      </div>
      <div class="blog-body">
        <Content />
      </div>
      <aside class="blog-sidebar" aria-label="サイドバー">
        <BlogToc items={tocItems} />
      </aside>
      <div class="blog-layout-footer">
        <BlogQuoteFootnotes sources={footnotes} />
        <div class="blog-layout-footer-profile">
          <ProfileBox />
          <BlogOtherPosts posts={otherPosts} />
        </div>
      </div>
    </article>
    <div class="blog-share-float" aria-label="記事をシェア">
      <ShareButtons url={postUrl} title={post.data.title} />
    </div>
    {
      hasTwitterEmbed && (
        <script async src="https://platform.twitter.com/widgets.js" charset="utf-8" />
      )
    }
    <script>
      (function initBlogShareFloat() {
        const float = document.querySelector('.blog-share-float');
        const footer = document.querySelector('.blog-layout-footer');
        if (!float || !footer) return;

        const mobileQuery = window.matchMedia('(max-width: 720px)');
        /** @type {IntersectionObserver | undefined} */
        let observer;

        function apply() {
          observer?.disconnect();
          observer = undefined;
          float.classList.remove('blog-share-float--receded');

          if (!mobileQuery.matches) return;

          observer = new IntersectionObserver(
            (entries) => {
              const entry = entries[0];
              if (!entry) return;
              float.classList.toggle('blog-share-float--receded', entry.isIntersecting);
            },
            {
              root: null,
              rootMargin: '0px 0px 80px 0px',
              threshold: 0,
            },
          );
          observer.observe(footer);
        }

        apply();
        mobileQuery.addEventListener('change', apply);
      })();
    </script>
  </main>
</BlogLayout>
