---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BlogPhotoMarquee from '../../components/BlogPhotoMarquee.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import BlogRandomButton from '../../components/BlogRandomButton.astro';
import { collectBlogPhotos } from '../../lib/blog-photos';
import { groupBlogPostsByYearMonth } from '../../lib/blog-posts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const archive = groupBlogPostsByYearMonth(posts);
const photos = collectBlogPhotos(posts);
---

<BlogLayout
  title="Blog | atohs.me"
  description="atohs(あとーす)のブログです。"
  ogUrl="https://atohs.me/blog"
>
  <SiteHeader />
  <main id="main-content" class="main main--blog-index">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <div class="keywords-heading-row blog-title-row">
      <h1 class="blog-title">Blog</h1>
      <div class="blog-title-row-actions">
        <a class="blog-stats-nav-link" href="/stats">Stats</a>
        <BlogRandomButton />
      </div>
    </div>

    {
      posts.length === 0 ? (
        <p>まだ記事はありません。</p>
      ) : (
        <BlogArchive archive={archive} />
      )
    }

  </main>
  <div class="blog-photo-marquee-shell">
    <BlogPhotoMarquee photos={photos} />
  </div>
</BlogLayout>
