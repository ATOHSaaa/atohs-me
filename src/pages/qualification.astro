---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const qualification = await getEntry('career', 'qualification');
if (!qualification) {
  throw new Error('Qualification content not found');
}
const { Content } = await render(qualification);
---

<BaseLayout title={`${qualification.data.title} | atohs.me`} ogUrl="https://atohs.me/qualification">
  <SiteHeader />
  <main id="main-content" class="main experience">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">Home</a><span class="breadcrumb-slash">/</span>
    </nav>
    <h1 class="page-title">{qualification.data.title}</h1>
    <div class="experience-body">
      <Content />
    </div>
  </main>
</BaseLayout>
