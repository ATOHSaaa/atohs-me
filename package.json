{
  "name": "atohs-me",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:reset": "node scripts/reset-astro-dev.mjs && npm run dev",
    "build": "astro build && node scripts/generate-cloudflare-redirects.mjs",
    "preview": "astro preview",
    "ensure-og-font": "node scripts/ensure-og-font.mjs",
    "favicon:generate": "node scripts/generate-favicon.mjs --force",
    "og:generate": "tsx scripts/generate-blog-og-images.ts",
    "og:generate:force": "tsx scripts/generate-blog-og-images.ts --force",
    "link-card-ogp:refresh": "node scripts/update-link-card-ogp.mjs --force",
    "sync:hanoi-clicker": "node scripts/sync-hanoi-clicker.mjs",
    "deploy:cf": "bash scripts/deploy-cf.sh",
    "deploy:cf:dry-run": "bash scripts/deploy-cf.sh --dry-run --outdir=.wrangler-dry-run",
    "ship": "bash scripts/ship.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "rehype-slug": "^6.0.0",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "to-ico": "^1.1.5",
    "tsx": "^4.23.15",
    "wrangler": "^4.155.0"
  }
}
